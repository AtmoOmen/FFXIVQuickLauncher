<UserControl x:Class="XIVLauncher.Windows.Main.LoginCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:transitions="clr-namespace:XIVLauncher.Xaml.Transitions"
             xmlns:slides="clr-namespace:XIVLauncher.Windows.Main.Slides"
             xmlns:viewModel="clr-namespace:XIVLauncher.Windows.ViewModel.Main"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel}"
             d:DesignHeight="532" d:DesignWidth="294">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="LoginCardSlideResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid KeyDown="Card_KeyDown">
        <materialDesign:Card
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            UniformCornerRadius="12"
            materialDesign:ElevationAssist.Elevation="Dp4"
            IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部工具栏 (仅 MainPage / Dashboard 显示) -->
            <Grid Grid.Row="0" Margin="10,10,10,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding ElementName=LoginCardTransitioner, Path=SelectedIndex}"
                                Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger
                                Binding="{Binding ElementName=LoginCardTransitioner, Path=SelectedIndex}"
                                Value="4">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <Button Style="{StaticResource HeaderUtilityButtonStyle}"
                            ToolTip="游戏维护"
                            Click="GameMaintenanceButton_OnClick">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom"
                                         DataContext="{Binding PlacementTarget.(FrameworkElement.DataContext), RelativeSource={RelativeSource Self}}"
                                         d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel}"
                                         Style="{StaticResource LoginActionContextMenuStyle}">
                                <MenuItem Header="修复游戏"
                                          Style="{StaticResource LoginActionMenuItemStyle}"
                                          Command="{Binding LoginPage.LoginRepairCommand}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="Wrench" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="检查游戏完整性"
                                          Style="{StaticResource LoginActionMenuItemStyle}"
                                          Command="{Binding LoginPage.RunIntegrityCheckCommand}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="ShieldCheck" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <materialDesign:PackIcon Kind="Wrench"
                                                 Width="19"
                                                 Height="19"
                                                 VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource HeaderUtilityButtonStyle}"
                            ToolTip="手动注入"
                            Command="{Binding LoginPage.InjectModeSwitchCommand}"
                            Visibility="{Binding Settings.EnableHooks, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="Injection" Width="19" Height="19" />
                    </Button>

                    <Button Style="{StaticResource HeaderUtilityButtonStyle}"
                            Margin="2,0,0,0"
                            ToolTip="软件设置"
                            Click="SettingsButton_OnClick">
                        <materialDesign:PackIcon Kind="Gear" Width="19" Height="19" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 手动注入顶栏 (仅 InjectMode 显示) -->
            <Grid Grid.Row="0" Margin="10,8,10,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding ElementName=LoginCardTransitioner, Path=SelectedIndex}"
                                Value="3">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Button Style="{StaticResource HeaderUtilityButtonStyle}"
                        ToolTip="{Binding InjectPage.ReturnButtonText}"
                        Command="{Binding InjectPage.ReturnToLoginPageCommand}"
                        HorizontalAlignment="Left">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" />
                </Button>
            </Grid>

            <!-- DCTravel 顶栏 (仅 DCTravel 显示) -->
            <Grid Grid.Row="0" Margin="10,8,10,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding ElementName=LoginCardTransitioner, Path=SelectedIndex}"
                                Value="5">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource HeaderUtilityButtonStyle}"
                        ToolTip="返回"
                        Command="{Binding DCTravelPage.BackToDashboardCommand}"
                        HorizontalAlignment="Left">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" />
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource HeaderUtilityButtonStyle}"
                        ToolTip="历史订单"
                        Command="{Binding DCTravelPage.OpenHistoryCommand}">
                    <materialDesign:PackIcon Kind="History" Width="20" Height="20" />
                </Button>
            </Grid>

            <!-- DCTravel 历史记录顶栏 (仅 History 显示) -->
            <Grid Grid.Row="0" Margin="10,8,10,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding ElementName=LoginCardTransitioner, Path=SelectedIndex}"
                                Value="6">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource HeaderUtilityButtonStyle}"
                        ToolTip="返回"
                        Command="{Binding DCTravelPage.BackToTravelCommand}"
                        HorizontalAlignment="Left">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" />
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource HeaderUtilityButtonStyle}"
                        ToolTip="刷新"
                        Command="{Binding DCTravelPage.RefreshOrdersCommand}"
                        IsEnabled="{Binding DCTravelPage.IsNotLoading}">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                </Button>
            </Grid>

            <!-- DCTravel 进度顶栏 (仅 Progress 显示) -->
            <Grid Grid.Row="0" Margin="10,8,10,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding ElementName=LoginCardTransitioner, Path=SelectedIndex}"
                                Value="7">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Button ToolTip="返回"
                        Command="{Binding DCTravelPage.ReturnFromProgressCommand}"
                        HorizontalAlignment="Left">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HeaderUtilityButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DCTravelPage.IsTravelInProgress}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" />
                </Button>
            </Grid>

            <!-- DCTravel 超域返回顶栏 (仅 Return 显示) -->
            <Grid Grid.Row="0" Margin="10,8,10,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding ElementName=LoginCardTransitioner, Path=SelectedIndex}"
                                Value="8">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Button Style="{StaticResource HeaderUtilityButtonStyle}"
                        ToolTip="返回"
                        Command="{Binding DCTravelPage.CancelReturnCommand}"
                        HorizontalAlignment="Left">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" />
                </Button>
            </Grid>

            <materialDesign:Transitioner x:Name="LoginCardTransitioner" Grid.Row="1"
                                         VerticalAlignment="Stretch"
                                         SelectedIndex="{Binding LoginCardTransitionerIndex}">
                <!-- Slide 0: 登录中 -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.ForwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.ForwardWipe>
                    <slides:LoginingSlide />
                </materialDesign:TransitionerSlide>

                <!-- Slide 1: 主登录页 -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <slides:MainLoginSlide x:Name="MainLogin" />
                </materialDesign:TransitionerSlide>

                <!-- Slide 2: 扫码登录 -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <slides:ScanQRSlide />
                </materialDesign:TransitionerSlide>

                <!-- Slide 3: InjectMode -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <materialDesign:SlideWipe />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <slides:InjectSlide />
                </materialDesign:TransitionerSlide>

                <!-- Slide 4: Dashboard -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.ForwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.ForwardWipe>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <slides:DashboardSlide x:Name="Dashboard" />
                </materialDesign:TransitionerSlide>

                <!-- Slide 5: DC Travel -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.ForwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.ForwardWipe>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <slides:DCTravelSlide />
                </materialDesign:TransitionerSlide>

                <!-- Slide 6: DC Travel 历史记录 -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.ForwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.ForwardWipe>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <slides:DCTravelHistorySlide />
                </materialDesign:TransitionerSlide>

                <!-- Slide 7: DC Travel 传送进度 -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.ForwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.ForwardWipe>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <slides:DCTravelProgressSlide />
                </materialDesign:TransitionerSlide>

                <!-- Slide 8: DC Travel 超域返回 -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.ForwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.ForwardWipe>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <slides:DCTravelReturnSlide />
                </materialDesign:TransitionerSlide>

                <!-- Slide 9: 账户管理器 -->
                <materialDesign:TransitionerSlide>
                    <materialDesign:TransitionerSlide.ForwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.ForwardWipe>
                    <materialDesign:TransitionerSlide.BackwardWipe>
                        <transitions:StableFadeWipe />
                    </materialDesign:TransitionerSlide.BackwardWipe>
                    <slides:AccountSwitcherSlide x:Name="AccountSwitcher" />
                </materialDesign:TransitionerSlide>
            </materialDesign:Transitioner>
        </Grid>
    </Grid>
</UserControl>

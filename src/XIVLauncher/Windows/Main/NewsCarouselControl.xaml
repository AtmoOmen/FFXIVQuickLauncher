<UserControl x:Class="XIVLauncher.Windows.Main.NewsCarouselControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:XIVLauncher.Windows.ViewModel.Main.Models"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="450">
    <Grid>
        <materialDesign:Card
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            UniformCornerRadius="12"
            materialDesign:ElevationAssist.Elevation="Dp2"
            IsHitTestVisible="False" />
        <Rectangle RadiusX="12" RadiusY="12"
                   Cursor="Hand"
                   MouseUp="BannerCard_MouseUp">
            <Rectangle.Fill>
                <ImageBrush x:Name="BannerBrush" Stretch="Fill"
                            ImageSource="pack://application:,,,/Resources/placeholder-news.png" />
            </Rectangle.Fill>
        </Rectangle>

        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,8,8"
                Padding="5,3"
                CornerRadius="8"
                Background="#52000000">
            <ItemsControl x:Name="BannerDot" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:BannerDotInfo}">
                        <RadioButton GroupName="banner"
                                     Style="{x:Null}"
                                     IsChecked="{Binding Active, Mode=OneWay}"
                                     Checked="BannerDot_OnChecked"
                                     MouseEnter="RadioButton_MouseEnter"
                                     MouseLeave="RadioButton_MouseLeave"
                                     Margin="0"
                                     Padding="3,2"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Focusable="False"
                                     Cursor="Hand">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <Border x:Name="DotBorder"
                                                Width="5"
                                                Height="5"
                                                CornerRadius="2.5"
                                                Background="#99FFFFFF" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="DotBorder" Property="Background"
                                                    Value="#FFFFFFFF" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="DotBorder"
                                                            Storyboard.TargetProperty="Width"
                                                            To="16" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="DotBorder"
                                                            Storyboard.TargetProperty="Width"
                                                            To="5" Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True" />
                                                <Condition Property="IsChecked" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="DotBorder" Property="Background"
                                                    Value="#DDFFFFFF" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="XIVLauncher.Windows.Main.Slides.MainLoginSlide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
             xmlns:loginModels="clr-namespace:XIVLauncher.Login.Models;assembly=XIVLauncher.Login"
             xmlns:viewModel="clr-namespace:XIVLauncher.Windows.ViewModel.Main"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel}"
             d:DesignHeight="492" d:DesignWidth="294">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Windows/Main/LoginCardSlideResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,0,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 居中登录核心区 (视觉略偏上) -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    Margin="0,0,0,12">
            <ComboBox x:Name="LoginTypeSelection"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                      materialDesign:HintAssist.Hint="登录方式"
                      Padding="12,12"
                      SelectionChanged="LoginTypeSelection_OnSelectionChanged"
                      SelectedItem="{Binding LoginPage.LoginTypeOption}"
                      SelectedValuePath="LoginType"
                      Tag="SelectionBox"
                      Margin="0,0,0,12">
                <ComboBox.Resources>
                    <CollectionViewSource x:Key="LoginTypeOptionsView"
                                          Source="{Binding LoginPage.LoginTypeOptions}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="GroupDisplay" />
                        </CollectionViewSource.GroupDescriptions>
                    </CollectionViewSource>
                </ComboBox.Resources>
                <ComboBox.ItemsSource>
                    <Binding Source="{StaticResource LoginTypeOptionsView}" />
                </ComboBox.ItemsSource>
                <ComboBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate DataType="{x:Type data:CollectionViewGroup}">
                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="11"
                                               Opacity="0.5"
                                               Margin="8,0,8,0"
                                               VerticalAlignment="Center" />
                                    <Separator Grid.Column="1"
                                               Margin="0,0,8,0"
                                               Background="{DynamicResource MaterialDesign.Brush.Card.Border}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ComboBox.GroupStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type loginModels:LoginTypeOption}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Ellipse Width="5"
                                         Height="5"
                                         Fill="{DynamicResource MaterialDesign.Brush.Primary}"
                                         VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Margin" Value="0,0,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                    Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Margin" Value="0,0,8,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding DisplayName}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Grid Grid.Column="1"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                                Value="SelectionBox">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <Border Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Opacity="0.12"
                                        CornerRadius="4" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Padding="4,2"
                                           Text="{Binding GroupDisplay}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Grid Margin="0,0,0,12"
                  Visibility="{Binding LoginPage.IsUsernameVisible, Converter={StaticResource BoolToVis}}">
                <TextBox x:Name="LoginUsername"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                         materialDesign:HintAssist.Hint="{Binding LoginPage.UsernameHint}"
                         Padding="12,12"
                         TextChanged="LoginUsername_OnTextChanged"
                         ToolTipService.ShowOnDisabled="True"
                         TextWrapping="NoWrap"
                         Text="{Binding LoginPage.Username, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding LoginPage.UsernameToolTip}"
                         IsEnabled="{Binding LoginPage.IsUsernameEnabled}"
                         Cursor="IBeam" />
                <Border VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,0"
                        CornerRadius="4"
                        Padding="6,2"
                        Background="#24FF9800"
                        Visibility="{Binding LoginPage.IsNewAccountBadgeVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="新账号"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                </Border>
            </Grid>

            <PasswordBox x:Name="LoginPassword"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         materialDesign:TextFieldAssist.TextFieldCornerRadius="10"
                         materialDesign:HintAssist.Hint="{Binding LoginPage.PasswordHint}"
                         Padding="12,12"
                         PasswordChanged="LoginPassword_OnPasswordChanged"
                         Visibility="{Binding LoginPage.IsPasswordVisible, Converter={StaticResource BoolToVis}}"
                         Cursor="IBeam"
                         Margin="0,0,0,12" />

            <WrapPanel Orientation="Horizontal"
                       HorizontalAlignment="Left"
                       Margin="2,0,0,16">
                <CheckBox x:Name="FastLoginCheckBox"
                          Content="{Binding LoginPage.FastLoginText}"
                          IsChecked="{Binding LoginPage.IsFastLogin}"
                          IsEnabled="{Binding LoginPage.IsFastLoginEnabled}"
                          Visibility="{Binding LoginPage.IsFastLoginVisible, Converter={StaticResource BoolToVis}}"
                          ToolTip="勾选后, 登录成功会保存账号信息, 下次可免密快速登录"
                          FontSize="12"
                          Opacity="0.88"
                          Margin="0,0,16,0" />
                <CheckBox x:Name="ReadWeGameInfoCheckBox"
                          Content="{Binding LoginPage.ReadWeGameInfoText}"
                          Visibility="{Binding LoginPage.IsReadWegameInfoVisible, Converter={StaticResource BoolToVis}}"
                          ToolTip="{Binding LoginPage.ReadWeGameInfoToolTip}"
                          FontSize="12"
                          Opacity="0.88"
                          IsChecked="{Binding LoginPage.IsReadWegameInfo}" />
            </WrapPanel>

            <Button x:Name="LoginButton"
                    Content="登录"
                    Command="{Binding LoginPage.StartLoginCommand}"
                    IsEnabled="{Binding LoginPage.CanStartLogin}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    materialDesign:ButtonAssist.CornerRadius="12"
                    materialDesign:ElevationAssist.Elevation="Dp2"
                    Height="44"
                    FontSize="15"
                    FontWeight="Bold">
                <Button.ContextMenu>
                    <ContextMenu Language="zh-CN"
                                 DataContext="{Binding PlacementTarget.(FrameworkElement.DataContext), RelativeSource={RelativeSource Self}}"
                                 d:DataContext="{d:DesignInstance Type=viewModel:MainWindowViewModel}"
                                 Style="{StaticResource LoginActionContextMenuStyle}">
                        <ContextMenu.Resources>
                            <Style TargetType="{x:Type MenuItem}"
                                   BasedOn="{StaticResource LoginActionMenuItemStyle}" />
                        </ContextMenu.Resources>
                        <MenuItem Header="调试用假启动"
                                  Command="{Binding LoginPage.FakeStartCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Button x:Name="AccountSwitcherButton"
                    Style="{StaticResource DashboardActionRowButtonStyle}"
                    Height="38"
                    Margin="0,10,0,0"
                    Command="{Binding AccountSwitcherButtonCommand}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:PackIcon Grid.Column="0"
                                             Kind="AccountGroupOutline"
                                             Width="16"
                                             Height="16"
                                             Margin="2,0,8,0"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                    <TextBlock Grid.Column="1"
                               Text="已保存账号"
                               FontSize="12"
                               FontWeight="Medium"
                               Opacity="0.88"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="2"
                            CornerRadius="7"
                            Padding="6,1"
                            Margin="0,0,4,0"
                            Background="#14FFFFFF"
                            VerticalAlignment="Center"
                            Visibility="{Binding AccountSwitcher.HasAccounts, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding AccountSwitcher.AccountCount}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Opacity="0.68" />
                    </Border>
                    <materialDesign:PackIcon Grid.Column="3"
                                             Kind="ChevronRight"
                                             Width="16"
                                             Height="16"
                                             VerticalAlignment="Center"
                                             Opacity="0.45" />
                </Grid>
            </Button>
        </StackPanel>

        <!-- 底部 Dalamud 状态条 -->
        <Button Grid.Row="1"
                HorizontalAlignment="Center"
                ToolTip="点击刷新 Dalamud 状态"
                Style="{StaticResource DalamudStatusButtonStyle}"
                Command="{Binding DalamudStatus.RefreshDalamudInfoCommand}"
                Visibility="{Binding Settings.EnableHooks, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Refresh"
                                         Width="12"
                                         Height="12"
                                         Margin="0,0,4,0"
                                         VerticalAlignment="Center"
                                         Opacity="0.75" />
                <TextBlock Text="{Binding DalamudStatus.StatusText}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>

<UserControl x:Class="XIVLauncher.Windows.Main.Slides.DCTravelReturnSlide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="240">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Windows/Main/LoginCardSlideResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,0,20,0" VerticalAlignment="Center">
        <StackPanel>
            <Border Style="{StaticResource DashboardInfoCardStyle}" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="返回订单" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{Binding DCTravelPage.ReturnOrderInfo}" FontSize="13" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:TextFieldAssist.TextFieldCornerRadius="8"
                      materialDesign:HintAssist.Hint="当前大区"
                      ItemsSource="{Binding DCTravelPage.ReturnSourceAreas}"
                      SelectedItem="{Binding DCTravelPage.ReturnSelectedSourceArea}"
                      DisplayMemberPath="AreaName"
                      Margin="0,0,0,8" />

            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:TextFieldAssist.TextFieldCornerRadius="8"
                      materialDesign:HintAssist.Hint="当前服务器"
                      ItemsSource="{Binding DCTravelPage.ReturnCurrentGroups}"
                      SelectedItem="{Binding DCTravelPage.ReturnSelectedCurrentGroup}"
                      DisplayMemberPath="GroupName"
                      Margin="0,0,0,8" />

            <CheckBox Content="完成时自动启动游戏"
                      IsChecked="{Binding DCTravelPage.AutoStartGameOnComplete}"
                      HorizontalAlignment="Center"
                      FontSize="11"
                      Margin="0,0,0,8" />

            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    materialDesign:ButtonAssist.CornerRadius="16"
                    Height="36" FontSize="12"
                    Command="{Binding DCTravelPage.ConfirmTravelBackCommand}"
                    IsEnabled="{Binding DCTravelPage.IsNotLoading}"
                    Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeftBold" Width="16" Height="16" Margin="0,0,6,0"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="确认返回" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
